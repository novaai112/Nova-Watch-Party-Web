SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# REQUIRED for the 18+ check (server only, never expose): Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 18+ check decision: 'dev' (testing only, approves everyone who passes the moves) or 'http' (real provider)
AGE_PROVIDER=dev
GOOGLE_API_KEY=your-google-custom-search-api-key-1,your-google-custom-search-api-key-2
GOOGLE_CX=your-google-programmable-search-engine-cx
YOUTUBE_API_KEY=your-youtube-data-api-key
DRIVE_API_KEY=optional-google-api-key-with-Drive-API-enabled (folder listing, names, lengths)
GOOGLE_CLIENT_ID=optional-oauth-web-client-id (Drive sign-in + picker)
GOOGLE_PICKER_API_KEY=optional-browser-api-key-with-Picker-API-enabled (referrer restricted)
