# Copy to .env and edit. Never commit .env.
# MUST be identical to AGE_PROVIDER_SECRET on the Nova server (Vercel / .env.local).
AGE_PROVIDER_SECRET=put-a-long-random-string-here

PORT=8080
HOST=127.0.0.1

# deepface (real model) | mock (fixed age, only for testing the plumbing)
ESTIMATOR=deepface
# opencv (fast, bundled) | ssd | mediapipe | retinaface (better, downloads extra weights)
DETECTOR=opencv

# Decision rule on the ESTIMATED age (the model is only accurate to roughly +/- 4-5 years):
#   estimate >= ADULT_AT   -> "adult"
#   estimate <  MINOR_BELOW -> "minor"
#   anything in between, no face, or several faces -> "uncertain" (user is asked to retry; nothing is unlocked)
ADULT_AT=25
MINOR_BELOW=18
